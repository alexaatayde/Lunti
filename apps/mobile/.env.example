# Copy to .env and fill in. Only EXPO_PUBLIC_* values belong here; they are bundled into the app.
# Never put service-role, Vision or OpenAI keys in this file (AGENTS.md §4.7).
# This file is for local development builds. EAS preview/production builds take these values
# from EAS environment variables and refuse http, local or missing addresses (docs/android-build.md).
EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1
# Supabase dashboard → Project Settings → API: Project URL and the anon (or publishable) key.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
