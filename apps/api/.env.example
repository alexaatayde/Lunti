# Copy to .env and fill in. Backend secrets live only here, never in the mobile app.

# Supabase → Project Settings → Database → Connection string.
# Use the Session pooler URI (IPv4, port 5432) or the Direct connection; insert your DB password.
# e.g. postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# https://<project-ref>.supabase.co — the API verifies access tokens against this project's
# public signing keys (JWKS). No JWT secret is needed for projects using signing keys.
SUPABASE_URL=
# Only for projects still on the legacy shared JWT secret (HS256). Leave empty otherwise.
SUPABASE_JWT_SECRET=
# Not used yet (admin tasks in later steps). Never expose it to the mobile app.
SUPABASE_SERVICE_ROLE_KEY=

GOOGLE_APPLICATION_CREDENTIALS=
OPENAI_API_KEY=
OPENAI_MODEL=
FCM_CREDENTIALS=
TZ=Asia/Manila

# Tests only: a PostgreSQL server where this user may CREATE DATABASE / CREATE ROLE
# (local or CI). Tests create and drop their own throwaway database. Never Supabase.
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
