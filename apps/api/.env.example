# Copy to .env and fill in. Backend secrets live only here, never in the mobile app.

# Supabase → Project Settings → Database → Connection string.
# Use the Session pooler URI (IPv4, port 5432) or the Direct connection; insert your DB password.
# e.g. postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# URL-encode special characters in the password (@ → %40, : → %3A, / → %2F, # → %23).
DATABASE_URL=

# https://<project-ref>.supabase.co — the API verifies access tokens against this project's
# public signing keys (JWKS). No JWT secret is needed for projects using signing keys.
SUPABASE_URL=
# Only for projects still on the legacy shared JWT secret (HS256). Leave empty otherwise.
SUPABASE_JWT_SECRET=
# Backend-only key for the private "receipts" Storage bucket (receipt photos).
# Never expose it to the mobile app. See README → Receipt scanning.
SUPABASE_SERVICE_ROLE_KEY=

# Absolute path to a Google Cloud service-account JSON key with the Vision API enabled.
GOOGLE_APPLICATION_CREDENTIALS=

# Receipt scanning adapters. Defaults: google / supabase. Development only, never production:
#   OCR_PROVIDER=fixture   (recognises the synthetic images in tests/fixtures/receipts)
#   RECEIPT_STORAGE=local  (photos under var/receipts, git-ignored)
# APP_ENV=production refuses both.
# APP_ENV=development
# OCR_PROVIDER=google
# RECEIPT_STORAGE=supabase
# RECEIPTS_BUCKET=receipts
OPENAI_API_KEY=
OPENAI_MODEL=
# Absolute path to a Firebase service-account JSON key (Cloud Messaging). Backend only.
# Empty = no push: notifications still appear in the app. See README → Notifications.
FCM_CREDENTIALS=

# Scheduled jobs in the API process (06:00 Asia/Manila reminders, push every minute).
# SCHEDULER_ENABLED=true
# DAILY_JOB_HOUR=6
TZ=Asia/Manila

# Per-user rate limits (Phase 8B). "N/unit" windows, comma-separated (second, minute, hour,
# day); empty = unlimited. Counted per API process (single-process deployment).
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_RECEIPT_UPLOAD=10/minute,50/day
# RATE_LIMIT_RECEIPT_CONFIRM=30/minute
# RATE_LIMIT_TRANSACTION_CREATE=30/minute,500/day
# Bodies over this many bytes get 413 (receipt uploads: RECEIPT_MAX_BYTES + 64 KB).
# REQUEST_MAX_BYTES=1048576

# Logging (Phase 8B). LOG_FORMAT json|text (default: json when APP_ENV=production).
# Production logs drop exception messages; SQL parameter values are never logged unless
# LOG_SQL_PARAMETERS=true — keep it off whenever real user data is involved.
# LOG_LEVEL=INFO
# LOG_FORMAT=
# LOG_SQL_PARAMETERS=false

# Tests only: a PostgreSQL server where this user may CREATE DATABASE / CREATE ROLE
# (local or CI). Tests create and drop their own throwaway database. Never Supabase.
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
